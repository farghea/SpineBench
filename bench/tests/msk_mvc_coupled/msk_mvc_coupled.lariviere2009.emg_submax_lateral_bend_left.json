  "sample": "20 right-handed healthy males; healthy right-handed men, in vivo",
  "age": "25±3 y",
  "sex": "M",
  "height_cm": "180±8",
  "weight_kg": "75±10"
 },
 "protocol": {
  "summary": "Triaxial dynamometer (feet, knees, pelvis stabilised; thorax in a frame on the force platform), upright standing; bilateral Delsys DE-2.3 electrodes: MU-L5 (~3 cm), IL-L3 (~5-6 cm), LO-L1 (~3 cm), RA, EO, IO (McGill 1991); five 5-s ramps 0-55% MVC per feedback condition.",
  "how_to_simulate": [
   "Upright standing, pelvis fixed, thorax loaded through a rigid frame; no hand load.",
   "Apply a pure lateral bend left moment at L5/S1 equal to 10,20,30,40,50% of the MVC (Table 1 mean 190±40 Nm, or subject-scaled) - matches the 3D-feedback condition; for 1D add the coupled moments (~2.5-11% MVC at 50%).",
   "Normalise each model muscle's activation by its maximum over simulated MVCs in all six directions; compare activations of muscles under the named electrode sites (left/right separately) with the 3D-feedback means."
  ],
  "subject_model": {
   "sex": "male",
   "age": 25,
   "height_cm": 180,
   "weight_kg": 75,
   "disc_area_mm2": null,
   "source": "Lariviere 2009 Methods"
  },
  "notes": "Only curves whose five force levels were separable in the figure were digitised; levels where curves/markers overlapped were omitted (see data). Figs S5 (back) and S6 (abdominals); right-side (contralateral) panels not digitised (2-7 %MVE, overlapping). The paper reports significant FEEDBACK effects mainly in frontal/transverse exertions (Table 2)."
 },
