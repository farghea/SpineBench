{
 "id": "passive_tissue.ebara1996.AF_circ_stress_strain_typical",
 "title": "Ebara 1996 multi-layer AF circumferential tension: nominal stress vs strain, four regions of one typical disc",
 "layer": "property",
 "category": "passive_tissue",
 "subcategory": "annulus",
 "region": "lumbar",
 "levels": [
  "L3-L4"
 ],
 "condition": "non-degenerate (Thompson grade I-II)",
 "quantity": {
  "name": "stress-strain curve",
  "definition": "nominal stress (axial force / undeformed cross-section) vs nominal strain (change in gauge-mark length / initial gauge length) in uniaxial circumferential tension at ~0.0001 /s; one typical specimen per region (AO, AI, PO, PI) from one L3-L4 disc (grade I, 28 y)",
  "unit": "MPa"
 },
 "source": {
  "short": "Ebara 1996",
  "authors": "Ebara S, Iatridis JC, Setton LA, Foster RJ, Mow VC, Weidenbaum M",
  "year": 1996,
  "journal": "Spine 21(4):452-461",
  "doi": "10.1097/00007632-199602150-00009",
  "n": 60,
  "sample": "60 multiple-layer circumferential AF specimens, 15 per region (anterior outer AO, anterior inner AI, posterolateral outer PO, posterolateral inner PI), from the L3-L4 discs of 15 lumbar spines (autopsy, frozen -20 C), Thompson grade I-II",
  "age": "26-53 y",
  "sex": "not reported",
  "height_cm": null,
  "weight_kg": null
 },
 "protocol": {
  "summary": "L3-L4 hemidisc; AF blocks from anterior and posterolateral regions, each split into inner and outer halves, microtomed to uniform thickness, soaked 15 min in 0.15 M NaCl, then a dumbbell cut with its long axis along the disc circumference (multi-layer, fibres at about +-30 deg to the load axis). Specimen ~10 mm long; gauge region 3.7 x 4.4 x 2.3 mm (L x W x T); thickness increased 17 % with soaking. Spring-loaded self-gripping jaws with polishing paper, test bath 0.15 M NaCl; preconditioning 10 cycles at 0.4 Hz to 0.05 N, then 0.1 N tare held 15 min; elongation at 0.07 mm/min (~0.0001 /s, quasi-static). Strain = change in gauge-mark length / initial gauge length (video dimension analyser); stress = force / undeformed cross-section. Per specimen cubic fit sigma = A eps + B eps^3; tensile modulus E = d sigma/d eps of the fit at 75 % of failure strain; failure stress/strain = maximum stress before failure and its strain, only for the 32 specimens that failed in the gauge region (24 failed at the grips, 4 by delamination outside the gauge).",
  "how_to_simulate": [
   "Multi-layer circumferential AF strip (gauge 3.7 x 4.4 x 2.3 mm), lamellae at about +-30 deg to the load axis, region-specific properties (anterior/posterolateral, outer/inner)",
   "Grip the ends, sides free, tare 0.1 N; pull circumferentially at ~0.0001 /s (quasi-static) in 0.15 M NaCl",
   "Report nominal stress (force / undeformed area) vs gauge nominal strain"
  ],
  "subject_model": null,
  "notes": "x_value = nominal strain (fraction), as plotted (no conversion needed). Symbols = measured data; solid lines in the figure are the cubic fits and were not read. Curves end at the last plotted point (not necessarily failure)."
 },
