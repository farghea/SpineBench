  "sex": "not reported",
  "height_cm": null,
  "weight_kg": null
 },
 "protocol": {
  "summary": "Uniaxial tension of entire ligaments, bones held in custom clamps (never the ligament or its insertions), universal joints; constant rate 1 mm/min for loading and relaxation; cadaver ligaments kept in water/alcohol/glycerin solution, surgical ligaments in Ringer and tested <1 h. CSA measured every 2 mm with a palpator, smallest value used for stress; length between nearest bony insertions. Curves sigmoid: point A = end of initial toe (concave) region, point B = end of linear region, point C = apex (rupture).",
  "how_to_simulate": [
   "Model the ligament between its bony insertions at the reported resting length and CSA (rows give length_mm, csa_mm2)",
   "Apply uniaxial elongation along the fibres at a quasi-static rate (1 mm/min) to rupture",
   "Report nominal stress (force / CSA) at the listed strains (elongation / resting length)"
  ],
  "subject_model": null,
  "notes": ""
 },
