 "extraction": {
  "from": "Fig 9 (a)-(f), solid 'Experiment Marini et al (2015)' lines, compression branch",
  "method": "digitised_figure",
  "uncertainty": "+/-0.03 mm or +/-40 N (half width of the experimental hysteresis loop plus pixel error); toe region below 100 N +/-20 N",
  "checked": true,
  "check_notes": "Page rendered at 600 dpi; axes calibrated from frame (left = axis minimum label) and the x=0 / F=0 grid lines (0.684 px/N in all panels). Experiment lines located by local-minimum scans (rows in the steep part, columns in the toe) and read against a 0.1 mm / 50 N overlay grid; points overlaid on the figure and checked by eye. Max compression displacement agrees with Table 3 model-experiment differences (e.g. No.1 model 0.536 vs exp 0.51 mm = +5%, Table 3: +5.67%). Loading vs unloading branch cannot be told apart in the figure, so the loop midline is given."
 },
 "pass_rule": {
  "template": true,
  "rule": "model force within +/-15% (or +/-40 N) of the specimen curve over 0-1000 N; compare per specimen or against the envelope of the 6 specimens"
 },
