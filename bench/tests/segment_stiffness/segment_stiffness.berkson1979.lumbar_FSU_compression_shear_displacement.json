{
 "id": "segment_stiffness.berkson1979.lumbar_FSU_compression_shear_displacement",
 "title": "Lumbar motion segment principal displacement under compression and shear (86, 145, 400 N), posterior elements intact vs destroyed",
 "layer": "property",
 "category": "segment_stiffness",
 "subcategory": "shear_stiffness",
 "region": "lumbar",
