 },
 "protocol": {
  "summary": "Mass of the trunk lumped per vertebral level from serial 1-cm CT slices.",
  "how_to_use": [
   "Lump upper-body mass at each vertebra T1-L5 using the %BM column (1.1 % at T1-T2 rising to 2.6 % at L4-L5); sum of T1-L5 means = 30.9 % (of the 41.4 % total trunk, rest in sacral/pelvic segment).",
   "Arms, head/neck are NOT included: add them separately (e.g. at T1 or via own segments).",
   "Use %trunk-mass column to redistribute a subject-specific trunk mass; SD (n=4) indicates inter-subject variability for robustness runs.",
   "Pair with level COM offsets (anthropometry.pearsall1996.level_com) to place each mass anterior to the vertebral centroid."
  ],
  "measurement": {
   "method": "CT",
   "device": "GE CT/T Continuum (Hi Light Advantage); pixel intensity calibrated to tissue density",
   "posture": "supine, upper limbs in anatomical position",
   "task": "static"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Vertebral-level segments bounded through the intervertebral discs (each contains one complete vertebral body); upper (thorax) = T1-T12, middle (abdomen) = L1-L5, lower (pelvis) = S1-S5 (pubic symphysis); trunk = T1-S5. Neck and upper limbs (lateral to glenohumeral joint) and lower limbs (lateral to hip joint) excluded. NOTE: these boundaries differ fundamentally from Pearsall 1994/Zatsiorsky/de Leva (landmark-based) trunk subsegments."
 },
