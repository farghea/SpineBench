 "protocol": {
  "summary": "CM of trunk subsegments with vertebral boundaries.",
  "how_to_use": [
   "Place thorax (T1-T12) COM at 54.5 % of its length from T1 (= 25.9 % of trunk length), ~4.0 cm anterior to the T7/T8 vertebral centroid.",
   "Place abdomen (L1-L5) COM at 56.3 % of its length (62.5 % of trunk length), ~1.0 cm anterior to the L3/L4 centroid.",
   "Place pelvis COM at 59.7 % of its length (86.9 % of trunk); whole trunk COM at 52.7 % of trunk length, ~2 cm anterior to the L1/L2 centroid (text)."
  ],
  "measurement": {
   "method": "CT",
   "device": "GE CT/T Continuum (Hi Light Advantage); pixel intensity calibrated to tissue density",
   "posture": "supine, upper limbs in anatomical position",
   "task": "static"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Vertebral-level segments bounded through the intervertebral discs (each contains one complete vertebral body); upper (thorax) = T1-T12, middle (abdomen) = L1-L5, lower (pelvis) = S1-S5 (pubic symphysis); trunk = T1-S5. Neck and upper limbs (lateral to glenohumeral joint) and lower limbs (lateral to hip joint) excluded. NOTE: these boundaries differ fundamentally from Pearsall 1994/Zatsiorsky/de Leva (landmark-based) trunk subsegments."
 },
