 ],
 "condition": "adults, stereo-photogrammetry",
 "quantity": {
  "name": "inertia tensor scaling factors",
  "definition": "r_ij = (1/L)·sqrt(I_ij/m) in the SCS; '(i)' in the paper = negative product of inertia (negative_product=true)",
  "unit": "% segment length"
 },
 "source": {
  "short": "Dumas 2007",
  "authors": "Dumas R, Chèze L, Verriest JP",
  "year": 2007,
  "journal": "J Biomech 40(3):543-553 (+ Corrigendum J Biomech 40:1651-1652)",
  "doi": "10.1016/j.jbiomech.2006.02.013",
  "n": 77,
  "sample": "77 living subjects (31 M from McConville 1980; 46 F from Young 1983) – secondary analysis; US adults (McConville et al. 1980 males; Young et al. 1983 females), stereo-photogrammetric body surface reconstruction",
  "age": "M mean 27.5 y; F mean 31.2 y",
  "sex": "31 M, 46 F",
  "height_cm": null,
  "weight_kg": null,
  "notes": "M: mean 80.5 kg, 1.77 m; F: mean 63.9 kg, 1.61 m. Corrigendum doi 10.1016/j.jbiomech.2006.07.016 (Head & Neck values corrected)."
 },
 "protocol": {
  "summary": "Full inertia tensor about the CoM, expressed in the SCS, scaled by mass and length.",
  "how_to_use": [
   "Compute I_ij = m·(r_ij·L)²; for products of inertia flagged negative_product, use I_ij = -m·(r_ij·L)².",
   "Use the subject's segment mass m (from anthropometry.dumas2007.trunk_mass) and joint-centre length L."
  ],
  "measurement": {
   "method": "stereo-photogrammetry (surface volumes, uniform density 1 g/cm³), adjusted to ISB segment coordinate systems",
   "device": "stereo-photogrammetry (McConville/Young)",
   "posture": "standing",
   "task": "static"
  },
  "equations": [],
  "subject_model": null,
  "notes": "SCS: Torso Y-axis LJC->CJC (cranial), Z normal to LJC-CJC-SUP plane pointing laterally (right), X = Y×Z (anterior); origin CJC. Pelvis: Z LASIS->RASIS, Y normal to ASIS-MPSIS plane pointing cranially, X = Y×Z; origin LJC. Head & Neck: Y CJC->HV, origin CJC. LJC/HJC from Reed et al. 1999. Torso = Thorax + Abdomen of the original data (C7/CJC to LJC, i.e. ~L5/S1), Pelvis = LJC to HJC level – boundaries are joint-centre based, unlike de Leva/Pearsall."
 },
