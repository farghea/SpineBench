 "levels": [],
 "condition": "older adults, DXA",
 "quantity": {
  "name": "segment length",
  "definition": "segment length as % of total height",
  "unit": "% height"
 },
 "source": {
  "short": "Chambers 2010",
  "authors": "Chambers AJ, Sukits AL, McCrory JL, Cham R",
  "year": 2010,
  "journal": "Clin Biomech 25(2):131",
  "doi": "10.1016/j.clinbiomech.2009.10.015",
  "n": 83,
  "sample": "83 healthy older adults (42 F, 41 M) in 8 subgroups; healthy adults >= 65 y split by sex, age (65-75 'old', >75 'elderly') and obesity (BMI<=30 vs >30); whole-body DXA",
  "age": "65-86 y (subgroup means 69.8-79.5 y)",
  "sex": "42 F, 41 M",
  "height_cm": null,
  "weight_kg": null,
  "notes": "Subgroup n: F old non-obese 8, F old obese 10, F elderly non-obese 13, F elderly obese 11, M old non-obese 7, M old obese 10, M elderly non-obese 14, M elderly obese 10. Subgroup height/mass/BMI/age in Table 1. Author manuscript (PMC). Pages printed as 25(2):131 in the manuscript header."
 },
 "protocol": {
  "summary": "DXA segment lengths; 8 subgroups.",
  "how_to_use": [
   "Scale the trunk (acromion-hip JC) to 33.8-35.8 % of stature for older adults."
  ],
  "measurement": {
   "method": "DXA",
   "device": "Hologic QDR 1000/W; 3.9-cm sections; assumed densities bone 2.5-3.0, fat 0.9, lean 1.08 g/cc",
   "posture": "supine",
   "task": "static"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Segments (dominant side): head vertex-mid-gonion; neck mid-gonion to mid-acromion; trunk = mid-acromion (trunk/upper-arm plane) to mid-hip-joint-centre (trunk/thigh plane) – i.e. whole trunk incl. pelvis; upper arm mid-acromion to elbow JC; forearm elbow JC-wrist JC; thigh HJC-KJC (pelvis excluded); shank KJC-lateral malleolus. Similar to de Leva (1996)."
 },
