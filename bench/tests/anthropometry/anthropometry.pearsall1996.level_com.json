  "name": "vertebral-level COM position",
  "definition": "positions of vertebral centroid (VC) and slice CM; x transverse, y antero-posterior (positive anterior), z longitudinal (from T1, cm); CM-VC = offset of slice COM from vertebral-body centroid",
  "unit": "cm"
 },
 "source": {
  "short": "Pearsall 1996",
  "authors": "Pearsall DJ, Reid JG, Livingston LA",
  "year": 1996,
  "journal": "Ann Biomed Eng 24:198-210",
  "doi": "",
  "n": "4 living subjects (2M, 2F)",
  "sample": "4 hospital-referred adults (2 male, 2 female), serial transverse CT at 1-cm intervals pubic symphysis to T1, supine",
  "age": "61.0 y (individuals 46, 65, 68, 65; printed SD 1.0 is inconsistent with individual ages)",
  "sex": "2M, 2F",
  "height_cm": 170.8,
  "weight_kg": 70.8,
  "notes": "height SD 13.8, mass SD 6.7, BMI 24.4 (2.4). DOI not printed (likely 10.1007/BF02667349 – verify). Subjects referred for medical reasons (pathology judged not to affect results)."
 },
 "protocol": {
  "summary": "Average VC and CM coordinates per level and the CM-VC offset.",
  "how_to_use": [
   "Place each level's lumped mass anterior to its vertebral-body centroid by CM-VC y: 0.8 cm at T1, 2.8 cm at T4, 4.6 cm at T8-T10, 3.5 cm at L1, 1.1 cm at L4, 0.4 cm at L5.",
   "Lateral (x) offsets are < 0.7 cm and can be set to zero for symmetric models.",
   "VC coordinates (supine) describe the spinal curvature of these 4 subjects with origin apparently at the L5 centroid; for upright models use the CM-VC offsets, not absolute coordinates."
  ],
  "measurement": {
   "method": "CT",
   "device": "GE CT/T Continuum (Hi Light Advantage); pixel intensity calibrated to tissue density",
   "posture": "supine, upper limbs in anatomical position",
   "task": "static"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Vertebral-level segments bounded through the intervertebral discs (each contains one complete vertebral body); upper (thorax) = T1-T12, middle (abdomen) = L1-L5, lower (pelvis) = S1-S5 (pubic symphysis); trunk = T1-S5. Neck and upper limbs (lateral to glenohumeral joint) and lower limbs (lateral to hip joint) excluded. NOTE: these boundaries differ fundamentally from Pearsall 1994/Zatsiorsky/de Leva (landmark-based) trunk subsegments."
 },
