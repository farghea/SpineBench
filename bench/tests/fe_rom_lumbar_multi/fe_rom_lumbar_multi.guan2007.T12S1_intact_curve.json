 },
 "protocol": {
  "summary": "Quasi-static pure moments (force couple on superior vertebra T12) to 4.0 Nm in flexion, extension, right and left lateral bending; S1 end on a 6-axis load cell; 30 s relaxation before each measurement; no preload; no axial rotation tested; off-axis moments monitored (<=0.03 Nm). Per-level rotation from optoelectronic markers.",
  "how_to_simulate": [
   "Model T12-S1 ligamentous column; fix S1 (embedded in PMMA), apply pure moment to T12 (embedded), no preload",
   "Apply flexion, extension, right and left lateral bending moments stepwise to 4.0 Nm (static; steps 0.5,1.5,2.5,3.5,4.0 Nm per methods, figure plots 0.5 Nm steps)",
   "Report the rotation of each segment (L1-L2 ... L5-S1) in the loading plane, measured from the unloaded position, at each step",
   "Compare segmental rotation at 4.0 Nm with mean ± SD (one direction, not range)"
  ],
  "notes": "Rotation measured from the unloaded neutral position at each moment step (no cycles; not a peak-to-peak range). NZ not reported. Specimens are T12-S1 but data are per-level L1-L2..L5-S1.",
  "subject_model": null
 },
