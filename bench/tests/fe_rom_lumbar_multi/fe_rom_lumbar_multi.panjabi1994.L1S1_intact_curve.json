  "name": "moment-rotation curve",
  "definition": "main rotation of each level (one direction, magnitude) at 2.5, 5, 7.5, 10 Nm, 3rd loading cycle; mean ± SD (one-sided SD bar)",
  "unit": "deg"
 },
 "source": {
  "short": "Panjabi 1994",
  "authors": "Panjabi MM, Oxland TR, Yamamoto I, Crisco JJ",
  "year": 1994,
  "journal": "J Bone Joint Surg Am 76(3):413-424",
  "doi": "10.2106/00004623-199403000-00012",
  "n": 9,
  "sample": "9 fresh-frozen lumbosacral spines (5 L1-S1, 4 L2-S1); L1-L2 n=5, other levels n=9; human cadaver ligamentous lumbosacral spines, all male",
  "age": "mean 51 y (range 35-62)",
  "sex": "all male",
  "height_cm": null,
  "weight_kg": null
 },
 "protocol": {
  "summary": "Pure moments (pneumatic actuator force couples on the cephalic vertebra) in flexion, extension, left/right axial torque, left/right lateral bending in 4 equal steps to 10 Nm; 3 load-unload cycles (first two preconditioning), 30 s creep at each step, stereophotographs at each step of the 3rd cycle; 100 N compressive preload kept along the line joining the centres of the most cephalic and caudal vertebral bodies throughout; sacrum fixed, L1 (or L2) loaded, intermediate vertebrae unconstrained.",
  "how_to_simulate": [
   "Model L1-S1 ligamentous spine; fix the sacrum; apply pure moments to L1 (cephalic mount)",
   "Apply a 100 N compressive preload along the straight line joining the cephalic and caudal vertebral body centres (stays on that line as the spine deforms; not a curved follower path)",
   "Apply ±10 Nm in flexion/extension, left/right axial torque and left/right lateral bending in steps of 2.5 Nm (3 cycles, use the 3rd loading branch)",
   "Report each level's main rotation (Euler angles X-Y-Z, from the 3rd-cycle starting position) at 2.5/5/7.5/10 Nm; coupled rotations at 10 Nm are a separate test"
  ],
  "notes": "Rotation at each moment step measured from the neutral position of the 3rd cycle; values are one direction (not range). The curves also show non-zero rotations at 0 Nm (neutral-zone-like offsets) - not extracted (markers overlap). Sign convention: +RX flexion, +RY left axial rotation, +RZ right lateral bending; main-motion values stored as magnitudes. Coupled translations (mm) in Figs 3-5 not extracted.",
  "subject_model": null
 },
