{
 "id": "kinematics.hajibozorgi2016.share_percent_flexion",
 "title": "Percent contribution of pelvis, lumbar and thorax to trunk flexion vs trunk angle",
 "layer": "input",
 "category": "kinematics",
 "subcategory": "thoracic/lumbar/pelvis shares",
 "region": "whole",
 "levels": [
  "pelvis",
  "T12-S1",
  "T1-T12"
 ],
 "condition": "healthy, standing, forward flexion phase only",
 "quantity": {
  "name": "share of trunk flexion",
  "definition": "segment rotation / total T1 trunk rotation x 100 at each 10% of full trunk flexion",
  "unit": "%"
 },
 "source": {
  "short": "Hajibozorgi 2016",
  "authors": "Hajibozorgi M, Arjmand N",
  "year": 2016,
  "journal": "J Biomech 49(6):913-918",
  "doi": "10.1016/j.jbiomech.2015.09.003",
  "n": "40 males",
  "sample": "40 young healthy male students, no history of back surgery or recent back/hip/knee complications",
  "age": "22.5 (SD 1.8), range 20-26 y",
  "sex": "male",
  "height_cm": "177.8 (SD 7.3), range 163-194",
  "weight_kg": "75.5 (SD 10.8), range 54-99"
 },
 "protocol": {
  "summary": "Stacked-bar % contributions; pelvis rises ~20%->40%, lumbar falls ~60%->42%, thoracic ~15-19% throughout.",
  "how_to_use": [
   "For a trunk flexion angle θ (T1 vs vertical), compute % of full flexion (full = 118.4 deg).",
   "Multiply θ by the pelvis, lumbar and thoracic shares at that % to get the three rotations.",
   "Distribute the thoracic part ~72/28 between T5-T12 and T1-T5 (see rotations test); flexion phase only."
  ],
  "measurement": {
   "method": "IMU",
   "device": "Xsens MTx inertial sensors (4) on T1, T5, T12 and S1 spinous processes, 100 Hz",
   "posture": "standing, feet shoulder-width, knees extended",
   "task": "slow (4-5 s) forward flexion from neutral upright to maximum voluntary flexion, 3 trials"
  },
  "equations": [],
  "subject_model": null,
  "notes": ""
 },
