    "name": "umbrella angle",
    "definition": "angle between the two ribs of a pair in the coronal plane (= sum of the two bucket-handle angles; Fig 2D)",
    "unit": "deg"
  },
  "source": {
    "short": "Vergari 2022",
    "authors": "Vergari C, Skalli W, Clavel L, Demuynck M, Valentin R, Sandoz B, Similowski T, Attali V",
    "year": 2022,
    "journal": "Comput Biol Med 144:105343",
    "doi": "10.1016/j.compbiomed.2022.105343",
    "n": 47,
    "sample": "47 healthy adults (21 F, 26 M) + 11 OSAS patients (7 M, 4 F); healthy volunteers with normal pulmonary function, no musculoskeletal/respiratory/neurological history",
    "age": "healthy 33 [25; 48] y (median [Q1; Q3]), range 20-83",
    "sex": "21 F / 26 M",
    "height_cm": "172 [165; 176] (median [Q1; Q3])",
    "weight_kg": "71 [61; 78] (median [Q1; Q3])",
    "bmi": "24 [21; 26] kg/m2"
  },
  "protocol": {
    "summary": "Coronal angle between rib planes of each pair from 3D EOS reconstructions.",
    "how_to_use": [
      "Use the FRC medians as the neutral standing rib configuration and the RV/TLC medians as the end-expiration/end-inspiration targets when driving a standing rib-cage breathing model.",
      "Impose bucket-handle elevation on inspiration: umbrella angle falls by ~12-22 deg (medians) from FRC to TLC (ribs become more coplanar); RV and FRC are similar.",
      "Use Q1-Q3 as the inter-subject range for robustness runs (n=47, 20-83 y; rib parameters did not change with age)."
    ],
    "measurement": {
      "method": "EOS biplanar radiograph",
      "device": "EOS low-dose slot-scanning biplanar X-ray; 3D reconstruction of T1-L5, ribs 1-10 and acetabula (statistical model + manual adjustment)",
      "posture": "free-standing, elbows fully flexed, fingers on cheekbones",
      "task": "acquisitions at FRC (normal breathing, reference), RV (full exhalation apnea) and TLC (full inhalation apnea), spirometer-checked"
    },
    "equations": [],
    "subject_model": null,
    "notes": "Box plots: median and 1st/3rd quartiles of the 47 healthy subjects (whiskers = 95% interval, not extracted). OSAS points overlaid in the figure not extracted. Lowest values mid-thorax (T5-T8). RV vs FRC not different; TLC significantly lower at all levels. Uncertainty of umbrella angle < 5.6 deg."
  },
