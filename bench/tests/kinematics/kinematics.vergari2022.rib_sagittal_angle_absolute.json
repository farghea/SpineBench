 },
 "protocol": {
  "summary": "Biplanar EOS radiographs at three lung volumes; 3D rib reconstructions; rib-pair frames; orientation vs horizontal.",
  "how_to_use": [
   "Use the FRC medians as the neutral standing rib configuration and the RV/TLC medians as the end-expiration/end-inspiration targets when driving a standing rib-cage breathing model.",
   "Impose pump-handle changes per rib: inspiration (FRC->TLC) lowers the angle by ~16 deg at upper ribs and ~7-11 deg at lower ribs; expiration (FRC->RV) raises it ~3-8 deg (text: ~5 deg median).",
   "Use Q1-Q3 as the inter-subject range for robustness runs (n=47, 20-83 y; rib parameters did not change with age).",
   "Note rib 1 not reconstructed; ribs 2-10 only."
  ],
  "measurement": {
   "method": "EOS biplanar radiograph",
   "device": "EOS low-dose slot-scanning biplanar X-ray; 3D reconstruction of T1-L5, ribs 1-10 and acetabula (statistical model + manual adjustment)",
   "posture": "free-standing, elbows fully flexed, fingers on cheekbones",
   "task": "acquisitions at FRC (normal breathing, reference), RV (full exhalation apnea) and TLC (full inhalation apnea), spirometer-checked"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Box plots: median and 1st/3rd quartiles of the 47 healthy subjects (whiskers = 95% interval, not extracted). OSAS points overlaid in the figure not extracted. Text: all lung-volume differences significant at all rib levels (p<0.05); change on inspiration -16 deg (upper) vs -8 deg (lower), expiration ~+5 deg (medians of within-subject change, Fig 4B). Measurement uncertainty (inter-operator SD) < 3.5 deg."
 },
