 "quantity": {
  "name": "lumbar angle and sacrum orientation",
  "definition": "Lumbar angle: sum of lordotic Epionics segments (negative = lordosis); sacrum orientation vs gravity (deg). Path points: mean curve at 0/33/66/100% of full flexion.",
  "unit": "deg"
 },
 "source": {
  "short": "Pries 2015",
  "authors": "Pries E, Dreischarf M, Bashkuev M, Putzier M, Schmidt H",
  "year": 2015,
  "journal": "J Biomech 48(12):3080-3087",
  "doi": "10.1016/j.jbiomech.2015.07.030",
  "n": 309,
  "sample": "309 subjects (134 M, 175 F); asymptomatic volunteers, BMI<26, age 20-75 (subset of the Consmuller 2012 cohort of 429); age groups 20-35 (n=155), 36-50 (n=100), >50 (n=54) (file K02_Pries2015.pdf)",
  "age": "38.4 (SD 14.0) y; range 20-75",
  "sex": "134 M / 175 F",
  "height_cm": "173.0 (SD 9.5); F 167.4, M 180.3",
  "weight_kg": "67.5 (SD 10.1); F 61.4, M 75.5"
 },
 "protocol": {
  "summary": "Absolute start/end postures by sex and age (Tables 2-3, text) and the mean lumbar-vs-sacrum flexion path (Fig 2a).",
  "how_to_use": [
   "Initialise the standing model with lumbar lordosis ~-34 deg (skin surface) and sacral orientation ~19.5 deg; adjust by sex/age (older: flatter lordosis, more vertical sacrum).",
   "Drive flexion along the mean path: (sacrum, lumbar) = (19.5,-34.2) -> (32.0,-5.0) at 33% -> (56.4,12.2) at 66% -> (92.2,18.5) at 100%; interpolate linearly between points.",
   "Note end posture (full flexion) is age-independent; age changes the start posture."
  ],
  "measurement": {
   "method": "skin-surface strain sensor (Epionics)",
   "device": "Epionics SPINE: 2 paravertebral strain-gauge strips (12 x 2.5 cm segments) 7.5 cm lateral of midline + tri-axial accelerometer at PSIS level (sacrum orientation)",
   "posture": "standing, knees extended",
   "task": "5 x maximal upper-body forward flexion from relaxed standing at preferred speed"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Path points digitised from Fig 2a (200 dpi, axis-calibrated), they reproduce published phase slopes 2.32/0.70/0.17 within 0.01."
 },
