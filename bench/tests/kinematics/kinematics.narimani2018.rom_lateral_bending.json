  "protocol": {
    "summary": "Maximal voluntary primary RoMs in standing measured with 4 inertial sensors.",
    "how_to_use": [
      "For a trunk (T1) lateral bend, distribute it ~50% thoracic (mostly T5-T12), ~35% lumbar, ~20% pelvis (left: 24.5/16.4/11.0 of 48.8 deg; right: 26.5/18.3/9.3 of 50.7 deg; sums exceed T1 because rotations are not strictly additive).",
      "Add coupled same-side thoracic twist / opposite-side lumbar twist from the coupled_rom test if needed."
    ],
    "measurement": {
      "method": "IMU",
      "device": "Xsens MTx inertial sensors (4) on T1, T5, T12 and S1 spinous processes",
      "posture": "standing, feet shoulder-width, knees extended",
      "task": "slow (4-5 s) maximal voluntary flexion, extension, left/right lateral bending, left/right axial rotation from relaxed upright, 3 trials"
    },
