 "quantity": {
  "name": "lumbopelvic ratio L/P",
  "definition": "Pelvis P = S1 sensor rotation vs global; thorax T = T5 sensor rotation vs global; lumbar L = L1 relative to S1; all relative to upright standing. L/P = total lumbar rotation / total pelvis rotation from upright (cumulative), not interval increments, unless stated. Interval 0-10% of extension = first 10% of the return, starting at full flexion.",
  "unit": "ratio"
 },
 "source": {
  "short": "Tafazzol 2014",
  "authors": "Tafazzol A, Arjmand N, Shirazi-Adl A, Parnianpour M",
  "year": 2014,
  "journal": "Clin Biomech 29(1):7-13",
  "doi": "10.1016/j.clinbiomech.2013.10.021",
  "n": 8,
  "sample": "8 males; 8 young asymptomatic males (file G06.pdf)",
  "age": "25.3 (SD 1.3) y",
  "sex": "male",
  "height_cm": "180.7 (SD 5.8)",
  "weight_kg": "80.1 (SD 6.3)"
 },
 "protocol": {
  "summary": "Same trials as flexion; L/P per 10% interval of the backward (return) movement (Table 3) and per 30 deg trunk-angle interval (Fig 5b).",
  "how_to_use": [
   "For the return phase, take the fraction of the return completed (0% = full flexion, 100% = upright) and read L/P from Table 3.",
   "Distribute: pelvis = trunk_pelvis_lumbar/(1+L/P), lumbar = L/P * pelvis (cumulative angles from upright).",
   "Note the pelvis leads early in the return (L/P ~1.07 at start) and the lumbar spine finishes it (L/P ~2.90 near upright): do not reuse the flexion table for lifting-up phases.",
   "In trunk-angle terms (Fig 5b, total-based) L/P = 1.23 at 90-120 deg rising to 2.86 at 0-30 deg."
  ],
  "measurement": {
   "method": "IMU",
   "device": "Xsens MTx inertial/magnetic sensors on spinous processes of T5, L1, S1",
   "posture": "standing, feet shoulder-width, knees extended",
   "task": "slow self-paced maximal forward flexion from upright and return to upright, 3 trials, no load, sagittal plane"
  },
  "equations": [
   "L/P = L / P (total rotations from upright)"
  ],
  "subject_model": null,
  "notes": "Fig 5b x-axis is trunk flexion range during the return."
 },
