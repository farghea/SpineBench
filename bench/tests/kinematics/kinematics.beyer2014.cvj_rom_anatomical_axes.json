  "quantity": {
    "name": "CVJ range of motion",
    "definition": "rotation range of each rib relative to its same-level vertebra between TLC, MIC and FRC poses, decomposed about vertebral anatomical frame axes: x anterior (upward(+)/downward(-) bending = 'bucket-handle'), y up (right(+)/left(-) rotation), z right (flexion(+)/extension(-) = 'pump-handle')",
    "unit": "deg"
  },
  "source": {
    "short": "Beyer 2014",
    "authors": "Beyer B, Sholukha V, Dugailly PM, Rooze M, Moiseev F, Feipel V, Van Sint Jan S",
    "year": 2014,
    "journal": "Clin Biomech 29:434-438",
    "doi": "10.1016/j.clinbiomech.2014.01.007",
    "n": 8,
    "sample": "8 asymptomatic volunteers; 8 asymptomatic adults, retrospective spiral CT (Erasme Hospital, Brussels) at 3 lung volumes (TLC, MIC, FRC)",
    "age": "30.4 (SD 5.5) y",
    "sex": "not reported",
    "height_cm": null,
    "weight_kg": null,
    "bmi": "21.1 (SD 2.2) kg/m2"
  },
  "protocol": {
    "summary": "Spiral CT at total lung capacity (TLC), mid inspiratory capacity (MIC) and functional residual capacity (FRC); 3D bone models; 5 virtual landmarks per rib/vertebra; rigid-body kinematics of ribs 1-7 relative to the vertebra of the same level; TLC used as reference.",
    "how_to_use": [
      "Use as the target rib excursion between full inspiration (TLC) and resting end-expiration (FRC) for ribs 1-7 in a rib-cage or breathing model (supine).",
      "Prescribe rib rotation relative to its own vertebra mainly about the x (bucket-handle, 4.6-8.9 deg) and z (pump-handle, 5.7-12.2 deg) axes; the y component is small (2.4-4.8 deg).",
      "Scale amplitude down caudally (rib 1 largest, rib 7 smallest); treat left and right as symmetric.",
      "Use the mean SD (~2.8 deg) to set the range for robustness checks; ribs 8-10 are not covered (see Beyer 2016 Fig 8)."
    ],
    "measurement": {
      "method": "CT",
      "device": "Siemens SOMATOM spiral CT, 0.5 mm slices, 1 mm spacing; virtual palpation of 5 landmarks per bone (lhpFusionBox)",
      "posture": "supine, breath-hold against closed airway (spirometer-controlled), upper limbs raised above head",
      "task": "static breath-holds at TLC, MIC and FRC"
    },
    "equations": [],
    "subject_model": null,
    "notes": "Values are ranges (always positive), not signed displacements. Intervertebral motion T1-T7 is reported separately. Mean SD of all rib ROMs 2.8 deg (text)."
  },
