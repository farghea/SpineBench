 },
 "protocol": {
  "summary": "Standing left lateral 36-inch radiograph at 72 in; hands on support (France) or fist-on-clavicle (North America); single observer, Optispine software.",
  "how_to_use": [
   "Set pelvic orientation of a standing model from PI: PT ~ 0.24*PI and SS ~ 0.76*PI (mean ratios), i.e. PT 13 deg, SS 40 deg for the mean PI 52.6 deg.",
   "Use mean +- 2SD bounds (PI 32-74, PT 0-27, SS 24-55 deg) as the normal envelope for robustness runs; no sex adjustment needed (differences < 0.5 deg).",
   "Age effects are small (r <= 0.21): PT and PT/PI rise and SS falls slightly with age; PI is age-independent."
  ],
  "measurement": {
   "method": "radiograph",
   "device": "standing lateral radiograph (film digitised at 75 dpi or digital), Optispine software",
   "posture": "standing, hips and knees fully extended, arms on support or fists on clavicles",
   "task": "quiet standing"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Correlations with age (Table 3, all/F/M): PI 0.03/0.06/0.005; PT 0.16/0.17/0.14 (p<0.01); SS -0.10 (p<0.01)/-0.08/-0.11; PT/PI 0.19/0.19/0.18; SS/PI -0.19/-0.19/-0.18; PT/SS 0.21/0.20/0.21 (all p<0.01; significance marks for F/M SS lost in text extraction). PI-PT r=0.65, PI-SS r=0.76, PT-SS r=-0.002 (Table 2). Sex differences n.s. (p 0.06-0.7). Possible overlap with Vialle 2005 cohort (shared author Guigui; French centres; recruitment 2000-2008) - not confirmed."
 },
