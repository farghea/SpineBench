{
 "id": "kinematics.vialle2005.segmental_angulation_T9_S1",
 "title": "Standing segmental sagittal angulation and vertebral wedging from T9 to S1",
 "layer": "input",
 "category": "kinematics",
 "subcategory": "standing spinopelvic alignment",
 "region": "lumbar",
 "levels": [
  "T9-S1"
 ],
 "condition": "in vivo, standing",
 "quantity": {
  "name": "reciprocal sagittal angulation between vertebrae",
  "definition": "cumulative sagittal angle between vertebra pairs from T9 to S1 (negative = lordosis), built by summing intervertebral angles and vertebral wedging; diagonal entries = vertebral wedging",
  "unit": "deg"
 },
 "source": {
  "short": "Vialle 2005",
  "authors": "Vialle R, Levassor N, Rillardon L, Templier A, Skalli W, Guigui P",
  "year": 2005,
  "journal": "J Bone Joint Surg Am 87(2):260-267",
  "doi": "10.2106/JBJS.D.02043",
  "n": 300,
  "sample": "300 asymptomatic volunteers (110 F, 190 M); volunteers 20-70 y without spinal disorder/surgery or radiographic abnormality; Hopital Beaujon, Clichy, France",
  "age": "35.4 +- 12 y (20-70)",
  "sex": "110 F / 190 M",
  "height_cm": null,
  "weight_kg": null,
  "bmi": "23.5 +- 3 kg/m2 (15-35)"
 },
 "protocol": {
  "summary": "Intervertebral angles and vertebral wedging T9-L5 measured on standing lateral radiographs and summed into a matrix of regional angles.",
  "how_to_use": [
   "Distribute standing lumbar lordosis per level: entry (X vs S1) is the angle from the upper endplate of X to the S1 endplate; entry (X vs Y), Y below X, runs from the upper endplate of X to the lower endplate of Y; diagonal = wedging of X.",
   "Disc (intervertebral) angle between X and the next vertebra Y = entry(X vs Y) - wedge(X) - wedge(Y); e.g. L4-L5 disc = -24.6 - (-2.6) - (-8) = -14.0 deg; L5-S1 disc = -23.3 - (-8) = -15.3 deg.",
   "Use these mean per-level angles to set the initial standing curvature of a lumbar/thoracolumbar model; the narrow limits describe uncertainty of the mean, not inter-subject spread (use Table I SDs for spread)."
  ],
  "measurement": {
   "method": "radiograph",
   "device": "lateral 30x90 cm film, constant source distance, centred on T12, digitised, SpineView software",
   "posture": "standing comfortably, knees extended, arms flexed forward 45 deg resting on supports",
   "task": "quiet standing, radiograph during inhalation"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Interpretation of row/column endplates inferred, not stated: it is the only reading consistent with Table I (row L1 vs L5 = -43 = L1-L5 lordosis) and with additive checks (L4-L5 disc angle from rows L4 and L3 both = -14.0 deg). Parenthesised limits are labelled '5% prediction limits' but their narrow width suggests 95% CI of the mean. Printed typos kept: T10 vs S1 limits '(-52 to -54)', T10 vs L3 limits '(-31 to -1)' (likely -3.1 to -1)."
 },
