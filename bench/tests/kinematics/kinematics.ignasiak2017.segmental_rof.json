  "weight_kg": "young 68.3 (SD 13.7); elderly 67.5 (SD 11.3)"
 },
 "protocol": {
  "summary": "Per-segment flexion at full forward bending; upper thoracic segments (C7-T5) extend while lower thoracic (T7-L1) flex most; elderly flex less at T9-T11 to L5-S and more at T5-T7.",
  "how_to_use": [
   "Distribute thoracic flexion mostly to T7-L1 (≈10-17 deg per 2-level segment, young) and none/negative to C7-T5 (≈ -11 deg, reflecting head/neck strategy and skin stretch).",
   "For elderly subjects shift flexion from T9-L1 and lumbar segments toward T5-T7.",
   "Each segment spans two vertebral levels; divide by 2 for per-level values. Medians only (no means)."
  ],
  "measurement": {
   "method": "skin markers (optical)",
   "device": "Vicon MX 12 cameras, 100 Hz; 11 spinous-process markers (C7,T3,T5,T7,T9,T11,L1-L5) + sacrum; cubic polynomial fitted to marker curve, segment angles from curve normals",
   "posture": "standing, feet hip-width, knees extended, arms relaxed",
   "task": "slow forward flexion at self-selected speed to end of range and return"
  },
  "equations": [],
  "subject_model": null,
  "notes": ""
 },
