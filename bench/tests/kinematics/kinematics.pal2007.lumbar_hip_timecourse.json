    "weight_kg": "77.3 (SD 11.5); BMI 24.3 (SD 3.0)"
  },
  "protocol": {
    "summary": "Group-mean lumbar and hip angle-time profiles (Fig 2a flexion, Fig 2b return) plus peak values, peak velocities and timing (Table 1).",
    "how_to_use": [
      "Drive a free-bending simulation with the time profiles: flexion starts at the lumbar spine (initiation 16% vs hip 26% of cycle), lumbar dominates 22-58%, equal 59-76%, hip dominates the last 24%.",
      "On return the hip (pelvis on femur) leads: hip initiates at 7.4% vs lumbar 12.1% and dominates the first 22%; thereafter both contribute equally (curves overlap, not digitised beyond 40%).",
      "End-of-range: lumbar 55.9 deg, hip 69.2 deg (L/H 0.81); 4/20 subjects were lumbar-dominant (64.0 vs 57.8 deg).",
      "Peak velocities: flexion lumbar 43.5, hip 49.0 deg/s; return lumbar -36.7, hip -43.4 deg/s."
    ],
    "measurement": {
      "method": "skin markers (optical)",
      "device": "12-camera Motion Analysis system, 60 Hz; markers T12, L3, ASIS, PSIS, greater trochanter, lateral femoral epicondyle, 1/3 thigh",
      "posture": "standing, feet 1/10 body height apart, knees straight",
      "task": "5 trials of maximal forward flexion, hold 2 counts, return to upright, self-paced within 10 s; time normalised to 100 points"
    },
    "equations": [],
    "subject_model": null,
    "notes": "Fig 2 curves digitised at 10% steps from a 300 dpi render (thick mean lines only, CI bands ignored); digitised end values (lumbar 56.0, hip 69.5) match Table 1 peaks (55.9, 69.2)."
  },
