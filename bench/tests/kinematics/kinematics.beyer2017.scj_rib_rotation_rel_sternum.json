 },
 "protocol": {
  "summary": "Spiral CT at TLC, MIC, FRC; landmark clouds on ribs, manubrium and sternum; rib-to-sternum finite helical axes.",
  "how_to_use": [
   "Use as the target relative rotation between each true rib and the sternum when the costal cartilage/sternocostal joints are modelled: ~15.5 deg at rib 1 decreasing to ~7.6 deg at rib 7 from TLC to FRC.",
   "Split the motion by lung volume: above MIC ~4-5 deg at all levels; below MIC 10.9 deg (rib 1) to 3.7 deg (rib 7).",
   "Error bars are standard errors (n=12); multiply by sqrt(12)=3.46 for an approximate SD before using as robustness range."
  ],
  "measurement": {
   "method": "CT",
   "device": "Siemens SOMATOM spiral CT, 0.5 mm slices, 1 mm spacing; virtual palpation of 5 landmarks per bone (lhpFusionBox)",
   "posture": "supine, breath-hold against closed airway (spirometer-controlled), upper limbs raised above head",
   "task": "static breath-holds at TLC, MIC and FRC"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Paper states 'All results are given as mean +- standard errors'; Fig 4 caption confirms SE bars, and rib-ROM text values coincide with the Fig 4 bars, so the 'se' field holds SE. Rib 1 and rib 7 values from text; ribs 2-6 digitised. MHA direction cosines (text): x -0.52 to -0.31, y 0.49 to 0.53, z 0.35 to 0.56 (sternum frame, mirrored to right side), no level effect."
 },
