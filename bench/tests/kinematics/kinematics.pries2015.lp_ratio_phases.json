{
 "id": "kinematics.pries2015.lp_ratio_phases",
 "title": "Incremental lumbopelvic ratio in early/middle/late forward flexion, by sex and age",
 "layer": "input",
 "category": "kinematics",
 "subcategory": "lumbopelvic rhythm",
 "region": "lumbar",
 "levels": [
  "lumbar (Epionics S1-S6)",
  "pelvis/sacrum"
 ],
 "condition": "healthy, standing, forward flexion",
 "quantity": {
  "name": "lumbopelvic ratio L/P (incremental, per third of flexion)",
  "definition": "Lumbar angle = sum of Epionics segments lordotic in standing (lordosis negative, kyphosis positive); sacrum orientation = accelerometer angle vs gravity (pelvis surrogate). Full RoF = value at max (lumbar+sacrum) minus standing. Phase L/P = incremental lumbar change / incremental sacral change over 0-33% (early), 33-66% (middle), 66-100% (late) of total flexion (sum of both angles).",
  "unit": "ratio"
 },
 "source": {
  "short": "Pries 2015",
  "authors": "Pries E, Dreischarf M, Bashkuev M, Putzier M, Schmidt H",
  "year": 2015,
  "journal": "J Biomech 48(12):3080-3087",
  "doi": "10.1016/j.jbiomech.2015.07.030",
  "n": "309 subjects (134 M, 175 F)",
  "sample": "asymptomatic volunteers, BMI<26, age 20-75 (subset of the Consmuller 2012 cohort of 429); age groups 20-35 (n=155), 36-50 (n=100), >50 (n=54) (file K02_Pries2015.pdf)",
  "age": "38.4 (SD 14.0) y; range 20-75",
  "sex": "134 M / 175 F",
  "height_cm": "173.0 (SD 9.5); F 167.4, M 180.3",
  "weight_kg": "67.5 (SD 10.1); F 61.4, M 75.5"
 },
 "protocol": {
  "summary": "Epionics lumbar curvature and sacral accelerometer during maximal forward flexion in 309 asymptomatic adults; L/P per third of flexion for whole cohort (mean curve), by sex (Table 3) and sex x age (Table 2).",
  "how_to_use": [
   "Express the target trunk motion as % of the subject's full flexion (sum of lumbar + sacral rotation; mean full = 52.1 + 72.1 = 124.2 deg).",
   "Distribute each increment with the phase L/P: early (0-33%) lumbar:pelvis 2.32:1, middle (33-66%) 0.70:1, late (66-100%) 0.17:1 (entire-cohort mean curve); i.e. lumbar share of the increment = L/P/(1+L/P).",
   "For a sex/age-specific subject use the median phase L/P from Table 2 (sex x age) or Table 3 (sex); early-phase values are highly skewed (ranges include large negative/positive outliers).",
   "Use with the lumbar_sacrum_posture test (mean path points at 0/33/66/100%) to reconstruct absolute lumbar angle vs sacral orientation; return phase not reported."
  ],
  "measurement": {
   "method": "skin-surface strain sensor (Epionics)",
   "device": "Epionics SPINE: 2 paravertebral strain-gauge strips (12 x 2.5 cm segments) 7.5 cm lateral of midline + tri-axial accelerometer at PSIS level (sacrum orientation)",
   "posture": "standing, knees extended",
   "task": "5 x maximal upper-body forward flexion from relaxed standing at preferred speed"
  },
  "equations": [
   "L/P_phase = delta lumbar angle / delta sacrum orientation within phase"
  ],
  "subject_model": null,
  "notes": "Entire-cohort phase values (2.32/0.70/0.17) are slopes of the mean lumbar-vs-sacrum curve (Fig 2a); sex/age values are medians (range) because L/P was not normally distributed. Early-flexion male 20-35 range -68.27 to 22.05 and female 20-35 range -12.86 to 24.18 (minus signs verified on rendered page). Sex effect significant for middle and late; age effect only early."
 },
