{
  "id": "kinematics.dreischarf2014.rof_lumbar_segmental",
  "title": "Segmental (Epionics S1-S6) lumbar range of flexion by sex and age",
  "layer": "input",
  "category": "kinematics",
  "subcategory": "lumbopelvic rhythm",
  "region": "lumbar",
  "levels": [
    "Epionics S1",
    "S2",
    "S3",
    "S4",
    "S5",
    "S6"
  ],
  "condition": "healthy, standing, maximal forward flexion",
  "quantity": {
    "name": "segmental lumbar range of flexion",
    "definition": "change of each Epionics segment angle from standing to maximal flexion. Epionics segments are 25 mm skin-surface arcs numbered from the PSIS (S1, ~lumbosacral) upward; S1-S6 cover the lordosis on average. They are NOT vertebral levels; map S1..S6 approximately to L5-S1..L1-L2/thoracolumbar by arc length along the subject's back.",
    "unit": "deg"
  },
  "source": {
    "short": "Dreischarf 2014b",
    "authors": "Dreischarf M, Albiol L, Rohlmann A, Pries E, Bashkuev M, Zander T, Duda G, Druschel C, Strube P, Putzier M, Schmidt H",
    "year": 2014,
    "journal": "PLoS One 9(12):e116186",
    "doi": "10.1371/journal.pone.0116186",
    "n": 323,
    "sample": "323 subjects (139 M, 184 F); asymptomatic volunteers, BMI<26 (106 of 429 excluded); age groups 20-29 (n=115: 66F/49M), 30-39 (70: 40F/30M), 40-49 (71: 41F/30M), >50 (67: 37F/30M) (file Dreischarf2014KIN.pdf)",
    "age": "38.6 (SD 14.0) y; range 20-75",
    "sex": "139 M / 184 F",
    "height_cm": "173.0 (SD 9.5); F 167.6 (6.9), M 180.1 (7.4)",
    "weight_kg": "67.6 (SD 10.1); F 61.7 (7.5), M 75.4 (7.5)"
  },
  "protocol": {
    "summary": "Per-segment lumbar RoF (S1-S6) by sex and 4 age groups (Table 4).",
    "how_to_use": [
      "Distribute total lumbar flexion over levels in proportion to the segment RoFs: young adults ~S1 13%, S2 18%, S3 22%, S4 21%, S5 16%, S6 10% of the S1-S6 sum (entire cohort 20-29: 6.6/8.8/10.9/10.2/7.8/4.9 deg).",
      "Map S1 (lowest, at PSIS) to the lumbosacral region and S6 to upper lumbar; segments are 25 mm skin arcs, not vertebrae.",
      "With age, mid-lumbar (S3-S5) RoF falls most; lumbosacral (S1) and thoracolumbar (S6) shares rise."
    ],
    "measurement": {
      "method": "skin-surface strain sensor (Epionics)",
      "device": "Epionics SPINE: two strips 7.5 cm paravertebral, 12 x 25 mm segments S1 (lowest, at PSIS ~S1) to S12; S1-S6 lordotic on average",
      "posture": "standing, knees extended",
      "task": "up to 6 x maximal upper-body flexion and extension at preferred speed from relaxed standing"
    },
    "equations": [],
    "subject_model": null,
    "notes": "Same Charite/Epionics volunteer database: Consmuller 2012 = all 429; Dreischarf 2014 = 323 with BMI<26; Pries 2015 = 309 (BMI<26 and valid sacral accelerometer). Do not pool these as independent samples. Percentages in how_to_use computed from the table means (sum 49.2 deg; total RoF 53.7 includes rounding/individual segment ranges)."
  },
