{
 "id": "kinematics.dreischarf2014.lordosis_standing",
 "title": "Standing lumbar lordosis, total and per Epionics segment, by sex and age",
 "layer": "input",
 "category": "kinematics",
 "subcategory": "standing spinopelvic alignment",
 "region": "lumbar",
 "levels": [
  "Epionics S1",
  "S2",
  "S3",
  "S4",
  "S5",
  "S6"
 ],
 "condition": "healthy, relaxed standing",
 "quantity": {
  "name": "lumbar lordosis (skin surface)",
  "definition": "sum of lordotic Epionics segment angles in relaxed standing (reported as positive magnitude). Epionics segments are 25 mm skin-surface arcs numbered from the PSIS (S1, ~lumbosacral) upward; S1-S6 cover the lordosis on average. They are NOT vertebral levels; map S1..S6 approximately to L5-S1..L1-L2/thoracolumbar by arc length along the subject's back.",
  "unit": "deg"
 },
 "source": {
  "short": "Dreischarf 2014b",
  "authors": "Dreischarf M, Albiol L, Rohlmann A, Pries E, Bashkuev M, Zander T, Duda G, Druschel C, Strube P, Putzier M, Schmidt H",
  "year": 2014,
  "journal": "PLoS One 9(12):e116186",
  "doi": "10.1371/journal.pone.0116186",
  "n": "323 subjects (139 M, 184 F)",
  "sample": "asymptomatic volunteers, BMI<26 (106 of 429 excluded); age groups 20-29 (n=115: 66F/49M), 30-39 (70: 40F/30M), 40-49 (71: 41F/30M), >50 (67: 37F/30M) (file Dreischarf2014KIN.pdf)",
  "age": "38.6 (SD 14.0) y; range 20-75",
  "sex": "139 M / 184 F",
  "height_cm": "173.0 (SD 9.5); F 167.6 (6.9), M 180.1 (7.4)",
  "weight_kg": "67.6 (SD 10.1); F 61.7 (7.5), M 75.4 (7.5)"
 },
 "protocol": {
  "summary": "Standing lumbar lordosis total and S1-S6 by sex and 4 age groups (Table 3).",
  "how_to_use": [
   "Set the standing lumbar curvature of the model to the total lordosis for the subject's sex/age and distribute it per segment (young: S3 and S4 largest).",
   "Aging flattens the middle part (S3-S5) while S1 is preserved.",
   "Skin-surface lordosis differs from radiographic Cobb lordosis; use radiographic sources for vertebral angles."
  ],
  "measurement": {
   "method": "skin-surface strain sensor (Epionics)",
   "device": "Epionics SPINE: two strips 7.5 cm paravertebral, 12 x 25 mm segments S1 (lowest, at PSIS ~S1) to S12; S1-S6 lordotic on average",
   "posture": "standing, knees extended",
   "task": "up to 6 x maximal upper-body flexion and extension at preferred speed from relaxed standing"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Same Charite/Epionics volunteer database: Consmuller 2012 = all 429; Dreischarf 2014 = 323 with BMI<26; Pries 2015 = 309 (BMI<26 and valid sacral accelerometer). Do not pool these as independent samples."
 },
