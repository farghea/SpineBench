  "doi": "10.1016/j.resp.2016.07.003",
  "n": 12,
  "sample": "12 asymptomatic volunteers (6 M, 6 F); 12 asymptomatic adults, retrospective spiral CT (Erasme Hospital) at TLC, MIC (FRC+50% IC) and FRC; lung volumes TLC 6.25+-1.1 l, FRC 3.44+-0.43 l, IC 2.82+-0.87 l",
  "age": "30 +- 6 y (Table 1; text says 31 +- 6)",
  "sex": "6 M / 6 F",
  "height_cm": "171 +- 8",
  "weight_kg": "63 +- 13"
 },
 "protocol": {
  "summary": "Same CT data as Table 2 of this paper, re-expressed as ranges about anatomical axes (Fig 8) to compare with 'pump/bucket handle' descriptions.",
  "how_to_use": [
   "Use to set anatomical-axis rib excursions for ribs 1-10 (extends Beyer 2014 Table 2 to ribs 8-10): x (bucket) ~9-10 deg at CVJ1-4 falling to ~4 deg at CVJ10; z (pump) ~13 deg at CVJ1 falling to ~5 deg at CVJ10; y 2-6 deg.",
   "Compare model rib-cage breathing kinematics (TLC to FRC) per level and per axis; use SD bars as the plausible range."
  ],
  "measurement": {
   "method": "CT",
   "device": "Siemens SOMATOM spiral CT, 0.5 mm slices, 1 mm spacing; virtual palpation of 5 landmarks per bone (lhpFusionBox)",
   "posture": "supine, breath-hold against closed airway (spirometer-controlled), upper limbs raised above head",
   "task": "static breath-holds at TLC, MIC and FRC"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Digitised from a horizontal bar chart (mean bars, SD whiskers). Sign convention in figure: left side plotted positive, right side negative; stored as magnitudes. Same subjects as test kinematics.beyer2016.cvj_rotation_about_mha."
 },
