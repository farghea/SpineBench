 "quantity": {
  "name": "CVJ angular displacement",
  "definition": "signed rotation of each rib relative to its same-level vertebra, in a joint coordinate system with Z along the subject's mean helical axis (rib lowering negative), X anterior, Y up; MIC and FRC poses relative to TLC (reference)",
  "unit": "deg"
 },
 "source": {
  "short": "Beyer 2016",
  "authors": "Beyer B, Van Sint Jan S, Cheze L, Sholukha V, Feipel V",
  "year": 2016,
  "journal": "Respir Physiol Neurobiol 232:57-65",
  "doi": "10.1016/j.resp.2016.07.003",
  "n": "12 asymptomatic volunteers (6 M, 6 F)",
  "sample": "12 asymptomatic adults, retrospective spiral CT (Erasme Hospital) at TLC, MIC (FRC+50% IC) and FRC; lung volumes TLC 6.25+-1.1 l, FRC 3.44+-0.43 l, IC 2.82+-0.87 l",
  "age": "30 +- 6 y (Table 1; text says 31 +- 6)",
  "sex": "6 M / 6 F",
  "height_cm": "171 +- 8",
  "weight_kg": "63 +- 13"
 },
 "protocol": {
  "summary": "Spiral CT at TLC, MIC, FRC; landmark-based rigid transformations of ribs 1-10 relative to vertebrae; finite/mean helical axes; joint frame with Z = MHA.",
  "how_to_use": [
   "Drive each rib (1-10) as a rotation about its costovertebral MHA: from TLC to FRC lower rib 1 by ~17-18 deg decreasing to ~6 deg at rib 10 (Z column, FRC rows).",
   "For mid-volume (MIC = FRC+50% IC), apply only ~3-6 deg (similar at all levels): rib rotation per litre is much smaller in the upper half of the inspiratory capacity (non-linear volume-rotation relation).",
   "Keep secondary X/Y rotations near zero (|mean| <= 1.3 deg); treat left and right sides as symmetric (no side effect, p=0.94).",
   "Use the MHA orientation (mean direction cosines ~0.58 on x and ~0.74 on z, global thorax frame; Fig 5A) when an axis is needed; inter-subject dispersion 8.3-25.5 deg."
  ],
  "measurement": {
   "method": "CT",
   "device": "Siemens SOMATOM spiral CT, 0.5 mm slices, 1 mm spacing; virtual palpation of 5 landmarks per bone (lhpFusionBox)",
   "posture": "supine, breath-hold against closed airway (spirometer-controlled), upper limbs raised above head",
   "task": "static breath-holds at TLC, MIC and FRC"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Text: principal component ranged -2.7 to -5.8 deg at MIC and -5.8 to -18.2 deg at FRC; normalised by IC: -2.1 to -1.3 deg/l (MIC) and -2.4 to 7.0 deg/l (FRC; sign as printed, likely -7.0). ROM above MIC ~35% of total at CVJ1-4 and ~50% at lower levels. No correlation with anthropometric/pulmonary variables (r<0.70). MHA direction-cosine panel (Fig 5A) not digitised."
 },
