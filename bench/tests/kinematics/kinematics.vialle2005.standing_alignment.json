 "quantity": {
  "name": "standing sagittal alignment parameters",
  "definition": "T4-T12 and maximum thoracic kyphosis, L1-L5 and maximum lumbar lordosis (negative = lordosis; maximum = from transitional vertebra to S1), T9 and T1 sagittal offsets (angle of the vertebra-to-hip-axis line vs vertical), SS, PI, PT",
  "unit": "deg"
 },
 "source": {
  "short": "Vialle 2005",
  "authors": "Vialle R, Levassor N, Rillardon L, Templier A, Skalli W, Guigui P",
  "year": 2005,
  "journal": "J Bone Joint Surg Am 87(2):260-267",
  "doi": "10.2106/JBJS.D.02043",
  "n": 300,
  "sample": "300 asymptomatic volunteers (110 F, 190 M); volunteers 20-70 y without spinal disorder/surgery or radiographic abnormality; Hopital Beaujon, Clichy, France",
  "age": "35.4 +- 12 y (20-70)",
  "sex": "110 F / 190 M",
  "height_cm": null,
  "weight_kg": null,
  "bmi": "23.5 +- 3 kg/m2 (15-35)"
 },
 "protocol": {
  "summary": "Standing lateral radiographs of head, spine and pelvis; digitised; SpineView measurements by three authors.",
  "how_to_use": [
   "Set a standing reference posture: T4-T12 kyphosis ~41 deg, L1-L5 lordosis ~43 deg (max lordosis ~60 deg), SS ~41 deg, PT ~13 deg, PI ~55 deg.",
   "Derive the subject's SS, PT and lordosis from PI with the Table V regressions so the posture is internally consistent; distribute lordosis per level with the T9-S1 segmental table (Vialle 2005 Table II test).",
   "Females: ~5 deg more L1-L5 lordosis, ~2 deg more SS and ~3 deg more PI than males; kyphosis and PT similar.",
   "Use SD/ranges for robustness; age effects are small (kyphosis r=0.2, PI r=0.14, lordosis r=0.14; vanish after adjusting for sex)."
  ],
  "measurement": {
   "method": "radiograph",
   "device": "lateral 30x90 cm film, constant source distance, centred on T12, digitised, SpineView software",
   "posture": "standing comfortably, knees extended, arms flexed forward 45 deg resting on supports",
   "task": "quiet standing, radiograph during inhalation"
  },
  "equations": [
   "SS = 7.3 + 0.63*PI (r=0.80)",
   "MLL = -16 - 1.06*SS (r=0.86; MLL = maximum lumbar lordosis, negative)",
   "PT = -7 + 0.37*PI (r=0.66)",
   "MLL = -2.72 - 1.1*PI + 1.1*PT - 0.31*MTK (r=0.9; MTK = maximum thoracic kyphosis)",
   "PI = 2.9 + 0.12*T9SO + 0.82*SS + 1.02*PT - 0.1*MLL - 0.032*MTK (r=0.98)"
  ],
  "subject_model": null,
  "notes": "Table I: SS mean 41.2 but printed 95% CI 40.91-42.81 (inconsistent; transcribed as printed). Abstract rounds: MLL 60 +- 10, SS 41 +- 8.4, PT 13 +- 6, PI 55 +- 10.6, T9 offset 10.3 +- 3.1. Transitional vertebra: T11 12.6%, T12 23.7%, L1 37.7%, L2 26%. Correlation matrix (Table IV) not transcribed. Possible overlap with Mac-Thiong 2011 (shared author Guigui; French recruitment) - not confirmed."
 },
