  "name": "CVJ mean helical axis direction cosines",
  "definition": "average (n=8) direction cosines of the mean helical axis of each rib relative to its vertebra, in the vertebral anatomical frame (x anterior, y up, z right)",
  "unit": "-"
 },
 "source": {
  "short": "Beyer 2014",
  "authors": "Beyer B, Sholukha V, Dugailly PM, Rooze M, Moiseev F, Feipel V, Van Sint Jan S",
  "year": 2014,
  "journal": "Clin Biomech 29:434-438",
  "doi": "10.1016/j.clinbiomech.2014.01.007",
  "n": "8 asymptomatic volunteers",
