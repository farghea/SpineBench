  "age": "30.4 (SD 5.5) y",
  "sex": "not reported",
  "height_cm": null,
  "weight_kg": null,
  "bmi": "21.1 (SD 2.2) kg/m2"
 },
 "protocol": {
  "summary": "Mean helical axis (MHA) from finite helical axes between the three CT poses; direction cosines averaged over subjects.",
  "how_to_use": [
   "Define each rib's costovertebral rotation axis with these direction cosines (in the vertebral frame) to drive breathing rib rotation as a single-DOF rotation.",
   "Axes lie roughly midway between the x and z axes (oblique, ~45 deg from the sagittal midplane); left and right are approximately mirror images (sign flip of x and y).",
   "Large inter-subject SD at ribs 3-7 on the right (up to 0.74): use as a range for axis-orientation sensitivity runs."
  ],
  "measurement": {
   "method": "CT",
   "device": "Siemens SOMATOM spiral CT, 0.5 mm slices, 1 mm spacing; virtual palpation of 5 landmarks per bone (lhpFusionBox)",
   "posture": "supine, breath-hold against closed airway (spirometer-controlled), upper limbs raised above head",
   "task": "static breath-holds at TLC, MIC and FRC"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Table 3 (single subject MHA and pivot points) not extracted (n=1)."
 },
