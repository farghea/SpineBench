 },
 "protocol": {
  "summary": "Mean pelvis, lumbar, upper/lower/total thoracic rotations at 10% steps of full trunk (T1) flexion (mean full T1 = 118.4 deg).",
  "how_to_use": [
   "Express the task trunk angle as % of full flexion (full T1 = 118.4 deg for this cohort, or the subject's own).",
   "Read pelvis, lumbar (T12-S1) and thoracic (T5-T12, T1-T5) rotations at that % (interpolate linearly between 10% steps).",
   "Apply pelvis rotation at S1/hip, lumbar rotation across T12-S1, and T5-T12 / T1-T5 rotation across the thoracic levels.",
   "Flexion phase only; no return/extension data. Check: pelvis+lumbar+T1-T12 sums to the T1 angle (within ~0.6 deg)."
  ],
  "measurement": {
   "method": "IMU",
   "device": "Xsens MTx inertial sensors (4) on T1, T5, T12 and S1 spinous processes, 100 Hz",
   "posture": "standing, feet shoulder-width, knees extended",
   "task": "slow (4-5 s) forward flexion from neutral upright to maximum voluntary flexion, 3 trials"
  },
  "equations": [],
  "subject_model": null,
  "notes": ""
 },
