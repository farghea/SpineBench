  ],
  "condition": "healthy, supine, pelvis fixed, active maximal trunk rotation (one side)",
  "quantity": {
    "name": "segmental coupled rotation and translation in axial rotation",
    "definition": "coupled lateral bending, flexion-extension (deg) and lateral/SI/AP translations (mm) of each vertebra relative to the inferior one at maximal trunk rotation (SRS local axes, Euler X-Y-Z); one side, right/left pooled",
    "unit": "deg / mm (see data.unit)"
  },
  "source": {
    "short": "Fujimori 2012",
    "authors": "Fujimori T, Iwasaki M, Nagamoto Y, Ishii T, Kashii M, Murase T, Sugiura T, Matsuo Y, Sugamoto K, Yoshikawa H",
    "year": 2012,
    "journal": "Spine 37(21):E1318-E1328",
    "doi": "10.1097/BRS.0b013e318267254b",
    "n": 13,
    "sample": "13 healthy male volunteers, not athletes/gymnasts, no spinal disorder/surgery/lung disease, scoliosis <5 deg (13 of the 15 men later used in Fujimori 2014 lateral-bending study)",
    "age": "33.2 (range 30-36) y",
    "sex": "male",
    "height_cm": "171.7 (range 168-186)",
    "weight_kg": "70.5 (range 57-91); BMI 23.9 (20.2-30.4)"
  },
  "protocol": {
    "summary": "Coupled 6-DOF motions per thoracic segment accompanying maximal supine trunk rotation.",
    "how_to_use": [
      "When imposing thoracic axial rotation per level, add same-direction coupled lateral bending: ~1.4-2.0 deg per segment at T1-T6, ~1 deg at T6-T8, ~0-0.6 deg at T8-T12, slightly opposite at T12-L1 (T1-L1 total 7.6 deg, ~30% of the 24.9 deg rotation).",
      "Add slight coupled flexion (0-1 deg per segment, largest at T11-L1); coupled translations are negligible (<=0.3 mm).",
      "Coupled LB direction is consistent at T1-T8 (85-96% of subjects same direction) but variable at T8-L1 (38-73%); use the frequency column to weight or randomise direction in robustness runs."
    ],
    "measurement": {
      "method": "CT",
      "device": "low-dose CT (GE LightSpeed), 0.625 mm slices, pixel 0.352 mm; voxel-based registration of each vertebra, Euler angles roll (X) - pitch (Y) - yaw (Z) relative to the inferior vertebra, SRS local axes",
      "posture": "supine, arms behind head, pelvis belted to the table (ASIS parallel), head kept neutral, cushions supporting the rotated trunk",
      "task": "active maximal trunk rotation (shoulder girdle along the trunk axis) to right and left within comfort (no defined moment)"
    },
    "equations": [],
    "subject_model": null,
    "notes": "Per-subject AR vs coupled LB scatter plots per level in Fig 4 (not digitised). Frequency of same-direction coupled LB did not differ significantly between levels (Kruskal-Wallis P = 0.3)."
  },
