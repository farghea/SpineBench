 },
 "protocol": {
  "summary": "EOS biplanar radiographs at RV, FRC, TLC; 3D spine/pelvis reconstruction; automatic spinopelvic parameters.",
  "how_to_use": [
   "Set standing spinal posture for a breathing simulation: at FRC use T1-T12 kyphosis ~51 deg, L1-L5 lordosis ~-44 deg, pelvic tilt ~11 deg (medians).",
   "Couple thoracic kyphosis to lung volume: increase kyphosis by ~12 deg at full expiration (RV) and decrease it by ~4-5 deg at full inspiration (TLC); keep lumbar lordosis constant; increase pelvic tilt ~4-5 deg at RV.",
   "Use Q1-Q3 for robustness; kyphosis increases with age (p<0.05) in this cohort."
  ],
  "measurement": {
   "method": "EOS biplanar radiograph",
   "device": "EOS low-dose slot-scanning biplanar X-ray; 3D reconstruction of T1-L5, ribs 1-10 and acetabula (statistical model + manual adjustment)",
   "posture": "free-standing, elbows fully flexed, fingers on cheekbones",
   "task": "acquisitions at FRC (normal breathing, reference), RV (full exhalation apnea) and TLC (full inhalation apnea), spirometer-checked"
  },
  "equations": [],
  "subject_model": null,
  "notes": "Median [Q1; Q3]. Healthy (n=47): kyphosis TLC<FRC and TLC<RV (p<0.001); lordosis not different; pelvic tilt TLC>FRC (p<0.05), TLC<RV (p<0.01), FRC<RV (p<0.001). Group 'matched healthy' = subset of the healthy cohort matched to OSAS patients for age/height/weight (subset size not reported; n=null): kyphosis TLC<FRC (p<0.01), TLC<RV (p<0.05); pelvic tilt TLC>RV (p<0.05), FRC>RV as printed (p<0.001)."
 },
