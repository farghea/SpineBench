 ],
 "condition": "healthy, standing, forward flexion",
 "quantity": {
  "name": "lumbopelvic ratio L/P",
  "definition": "Pelvis P = S1 sensor rotation vs global; thorax T = T5 sensor rotation vs global; lumbar L = L1 relative to S1; all relative to upright standing. L/P = total lumbar rotation / total pelvis rotation from upright (cumulative), not interval increments, unless stated.",
  "unit": "ratio"
 },
 "source": {
  "short": "Tafazzol 2014",
  "authors": "Tafazzol A, Arjmand N, Shirazi-Adl A, Parnianpour M",
  "year": 2014,
  "journal": "Clin Biomech 29(1):7-13",
  "doi": "10.1016/j.clinbiomech.2013.10.021",
  "n": "8 males",
  "sample": "8 young asymptomatic males (file G06.pdf)",
  "age": "25.3 (SD 1.3) y",
  "sex": "male",
  "height_cm": "180.7 (SD 5.8)",
  "weight_kg": "80.1 (SD 6.3)"
 },
 "protocol": {
  "summary": "8 young males flexed forward slowly to maximum from upright standing; IMUs at T5, L1, S1 gave pelvis, lumbar and thorax rotation; L/P computed per 10% interval of full trunk flexion (Table 2) and per 30 deg trunk-angle interval (Fig 5a, total-based and incremental-based).",
  "how_to_use": [
   "Normalise the target trunk flexion angle by the subject's full trunk (T5) flexion (mean 121 deg) and pick the matching 10% interval from Table 2.",
   "Split the pelvis+lumbar part of trunk rotation as pelvis = (T - T5_L1)/(1+L/P), lumbar = L/P * pelvis; T5-L1 adds ~8.3 deg at full flexion (scale linearly if needed).",
   "Remember L/P here is cumulative (total L / total P from upright); for incremental (interval) distribution use the 'incremental' Fig 5a values.",
   "Use the separate return test (lp_ratio_return) for the extension phase - the rhythm is not symmetric.",
   "Use per-subject spread (SD 0.13-0.21) for robustness runs; data are young males only."
  ],
  "measurement": {
   "method": "IMU",
   "device": "Xsens MTx inertial/magnetic sensors on spinous processes of T5, L1, S1",
   "posture": "standing, feet shoulder-width, knees extended",
   "task": "slow self-paced maximal forward flexion from upright and return to upright, 3 trials, no load, sagittal plane"
  },
  "equations": [
   "L/P = L / P (total rotations from upright)"
  ],
  "subject_model": null,
  "notes": "L5-S1 loads in Fig 4 are model outputs (not extracted). Per-subject L/P in Table 2 available if individual robustness runs are wanted."
 },
