 "id": "fe_idp_invitro.cannella2008.ACU_denucleation_idp_rel",
 "title": "Nucleus pressure after stepwise denucleation, normalised to intact, at axial loads -100 to 1400 N (lumbar ACUs)",
 "layer": "outcome",
 "category": "fe_idp_invitro",
 "subcategory": "IDP relative after nucleotomy",
 "region": "lumbar",
