  "L4-L5"
 ],
 "condition": "partial denucleation 5/10/15/20 min (DS1)",
 "quantity": {
  "name": "IDP relative",
  "definition": "nucleus pressure (mean of loading/unloading) after each cumulative denucleation step divided by the intact value at the same axial load; RELATIVE, not absolute; mean ± SD (upper whisker)",
  "unit": "ratio (intact = 1)"
 },
 "source": {
  "short": "Cannella 2008",
  "authors": "Cannella M, Arthur A, Allen S, Keane M, Joshi A, Vresilovic E, Marcolongo M",
  "year": 2008,
  "journal": "J Biomech 41:2104-2111",
  "doi": "10.1016/j.jbiomech.2008.04.037",
  "n": 12,
  "sample": "12 cadaveric anterior column units in two data sets of 6 (DS1: 2 T12-L1, 2 L2-L3, 2 L4-L5; DS2: L1-L2, L2-L3, L3-L4, 3 L4-L5); human cadaver ACUs (posterior elements removed), no severe degeneration",
  "age": "DS1 47 ± 19 y (30-64); DS2 49 ± 13 y (26-65)",
  "sex": "3 M / 3 F per data set",
  "height_cm": null,
  "weight_kg": null
 },
 "protocol": {
  "summary": "ACUs potted in Smooth-Cast 300 on a servohydraulic frame (Instron 8874); DS2 in a Spenciner-type pure-moment jig (6-DOF load cell, XY table; ~5% off-axis loads), DS2 displacements corrected for jig stiffness (1700 N/mm, 30 Nm/deg torsion, 10 Nm/deg bending). DS1: preconditioning 50 cycles at 3% disc height (1 Hz), then axial 150 N tension to 1500 N compression, 5 cycles, 0.1 Hz; nucleus pressure needle (14 G, transducer) through the anterior annulus, tip in the nucleus at half the minor-axis length from the outer wall. DS2: preconditioning 50 cycles 50-150 N compression (1 Hz), then separately axial 150 N tension to 1000 N compression and ±7.5 Nm AR, LB, FE, 5 sinusoidal cycles at 0.1 Hz. 5th cycle analysed. Neutral position = midpoint of zero-load positions of loading/unloading; NZ = difference between loading and unloading curves at zero load (Wilke 1998); ROM = maximum displacement/rotation in one direction from neutral.",
  "how_to_simulate": [
   "Model a lumbar disc-only unit; fix the inferior body",
   "Apply 50 N axial compression (and the 0-1400 N load steps for the slope)",
   "Report nucleus pressure at the needle position (nucleus, half the minor-axis length from the anterior outer wall)"
  ],
  "notes": "Resection steps (posterolateral 2 mm automated Nucleotome, under 50 N compression): DS1 intact -> intact with pressure needle -> denucleation 5, 10, 15, 20 min cumulative (dry nucleus removed ~37/60/84/100% of the 20-min amount; 20 min ≈ 0.15 g dry); DS2 intact -> single 20-min denucleation. Values after denucleation are normalised to the same specimen's intact value (relative, not absolute).",
  "subject_model": null
 },
