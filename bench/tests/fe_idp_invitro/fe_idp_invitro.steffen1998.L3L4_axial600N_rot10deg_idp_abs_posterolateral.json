 "quantity": {
  "name": "IDP",
  "definition": "absolute pressure (mean, SEM) at 6, 9, 12 mm from the outer posterolateral disc border, left and right needles; 'ipsilateral' = rotation towards the needle side",
  "unit": "kPa"
 },
 "source": {
  "short": "Steffen 1998",
  "authors": "Steffen T, Baramki HG, Rubin R, Antoniou J, Aebi M",
  "year": 1998,
  "journal": "Clin Biomech",
  "doi": "10.1016/S0268-0033(98)00039-4",
  "n": 16,
  "sample": "human cadaver lumbar L1-S1 spines (L1-L2 and L5-S1 fused with screws), Thompson grade II (13) / III (3); 16 specimens (L1-S1 spines; L3-L4 disc instrumented; 1 grade IV disc excluded per text)",
  "age": "mean 46.3 (range 29-63)",
  "sex": "10M, 6F",
  "height_cm": null,
  "weight_kg": null
 },
 "protocol": {
  "summary": "L1-S1 spine, L1/L2 and L5/S1 fused, ends in plaster with L3/L4 disc parallel to fixtures; 6-DOF custom machine: upper platform displacement-controlled (compression, AR, FE), lower platform free in LB and both horizontal translations. 300 N held 15 min, then 600 N axial compression with whole-specimen positions upright, 15 deg flexion, 10 deg extension; at each, 10 deg axial rotation to each side (whole specimen); 2 preconditioning cycles, then a recording cycle (left-to-right and right-to-left, averaged). IDP: three 2.1 mm needles in the mid-plane of L3/L4 (anterior mid-sagittal; left and right posterolateral at 30 deg to sagittal plane), each with three 1.6 mm strain-gauge transducers 6, 9, 12 mm from the outer disc border facing upward. Absolute pressure (kPa), mean (SEM).",
  "how_to_simulate": [
   "Model L1-S1 (or L2-L5 with rigid ends) with L3/L4 disc horizontal; apply 600 N axial compression on the upper end.",
   "Impose whole-specimen sagittal posture (upright, 15 deg flexion, 10 deg extension) and then 10 deg axial rotation to each side (displacement control; lateral bending and horizontal translations free).",
   "Read pressure (hydrostatic or minimum principal stress) at points 6, 9, 12 mm from the outer L3/L4 disc border along the anterior and posterolateral needle paths; compare with Table 1/2 (SEM given; SD = SEM*sqrt(16))."
  ],
  "subject_model": null,
  "notes": "Sensor tissue zones (Table 4, n=16): anterior needle 12 mm: 13 nuclear/3 intermediate/0 annular; 9 mm: 0/9/7; 6 mm: 0/0/16. PL left 12 mm: 16/0/0; 9 mm: 7/7/2; 6 mm: 0/1/15. PL right 12 mm: 15/1/0; 9 mm: 9/6/1; 6 mm: 0/2/14. Needle insertion (0.08 ml) estimated to add ~26 kPa. Pressure gradients (Fig 5) and differences vs upright (Fig 6) not extracted."
 },
