{
  "id": "lumbar_idp_invivo",
  "title": "Lumbar disc pressure in vivo",
  "domain": "msk",
  "region": "lumbar",
  "levels": [
    "L4-L5",
    "L3-L4"
  ],
  "summary": "Simulate each posture or hand-load task for the study subject and report L4-L5 intradiscal pressure (MPa).",
  "simulate": [
    "Scale the model to the study subject (subjects table).",
    "Set the posture: trunk flexion = trunk inclination from upright; sitting, lying, bending and twisting as described.",
    "Add the hand load at the stated position (both hands unless stated).",
    "Output L4-L5 compression F and L4-L5 flexion θ from standing (L3-L4 for standing_l3l4).",
    "IDP = Ghezelbash 2016 Eq. 6: -0.01556 + 1.255P + 0.01243θ + 0.03988P² - 0.01212Pθ + 0.001669θ² (P = F/A, MPa); or IDP = F/(0.66A)."
  ],
  "inputs": [
    {
      "key": "posture",
      "label": "Posture"
    },
    {
      "key": "trunk_flexion_deg",
      "label": "Trunk flexion",
      "unit": "deg"
    },
    {
      "key": "lateral_bend_deg",
      "label": "Lateral bending",
      "unit": "deg"
    },
    {
      "key": "axial_rotation_deg",
      "label": "Axial rotation",
      "unit": "deg"
    },
    {
      "key": "hand_load_kg",
      "label": "Hand load",
      "unit": "kg"
    },
    {
      "key": "load_position",
      "label": "Load position"
    }
  ],
  "outputs": [
    {
      "key": "idp",
      "label": "IDP",
      "unit": "MPa",
      "definition": "IDP = absolute pressure in the nucleus, measured by a needle transducer in the disc (MPa)"
    }
  ],
