{
  "id": "nucleus_endplate_tissue",
  "title": "Nucleus, endplate and whole disc",
  "domain": "tissue",
  "region": "lumbar",
  "levels": [
    "L1-L2",
    "L2-L3",
    "L3-L4",
    "L4-L5"
  ],
  "summary": "Simulate slow (quasi-static) tests of nucleus, annulus and endplate plugs and of whole discs, and report equilibrium moduli, swelling, shear and strain.",
  "simulate": [
    "Build each specimen at its stated size: NP cylinder, confined plug (4-5 mm), or disc with vertebrae.",
    "Use the stated bath (0.15 M saline/PBS) and let the tissue swell to equilibrium before loading.",
    "Load slowly and hold to equilibrium; report equilibrium values only (no rate or frequency effects).",
    "Whole disc: fix the lower vertebra, apply the stated preload, then the shear, compression or rotation.",
    "Use nominal stress (force / undeformed area) and nominal strain (ΔL / L0)."
  ],
  "inputs": [
    {
      "key": "tissue",
      "label": "Tissue"
    },
    {
      "key": "region",
      "label": "Region"
    },
    {
      "key": "mode",
      "label": "Test mode"
    },
    {
      "key": "condition",
      "label": "Condition"
    },
    {
      "key": "fit_model",
      "label": "Fitted model"
    }
  ],
  "outputs": [
    {
      "key": "shear_modulus_eq",
      "label": "Equilibrium shear modulus",
      "unit": "kPa",
      "definition": "Equilibrium shear modulus = shear stress / shear strain at the end of a 600 s hold (kPa)"
    },
    {
      "key": "aggregate_modulus",
      "label": "Aggregate modulus",
      "unit": "MPa",
      "definition": "Aggregate modulus = equilibrium nominal stress / nominal strain in confined compression, from the named fit (MPa)"
    },
    {
      "key": "swelling_stress",
      "label": "Confined swelling stress",
      "unit": "MPa",
      "definition": "Equilibrium axial stress of a confined plug held at fixed thickness in 0.15 M NaCl (MPa)"
    },
    {
      "key": "swelling_ratio",
      "label": "Swollen / fresh weight",
      "unit": "-",
      "definition": "Swollen / fresh wet weight at equilibrium (-)"
    },
    {
      "key": "shear_stiffness",
      "label": "Shear stiffness",
      "unit": "N/mm",
      "definition": "Shear force / shear displacement of the upper vertebra, 0-150 N, 2nd cycle, 500 N preload (N/mm)"
    },
    {
      "key": "shear_strength",
      "label": "Shear strength",
      "unit": "kN",
      "definition": "Peak anterior shear force, displacement at 0.5 mm/s to failure, 500 N preload (kN)"
    },
    {
      "key": "mss_per_mm",
      "label": "Max shear strain per mm",
      "unit": "%/mm",
      "definition": "Largest regional 3-D maximum shear strain in the mid-disc plane per mm of imposed translation (%/mm)"
    },
    {
      "key": "mss_per_deg",
      "label": "Max shear strain per degree",
      "unit": "%/deg",
      "definition": "Largest regional 3-D maximum shear strain in the mid-disc plane per degree of imposed rotation (%/deg)"
    }
  ],
