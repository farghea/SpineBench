{
  "id": "implant_loads_invivo",
  "title": "Spinal implant loads in vivo",
  "domain": "msk",
  "region": "lumbar+thoracic",
  "levels": [
    "L1",
    "L3",
    "T10-L5 (fixator)"
  ],
  "summary": "Simulate each activity for the implant patients and report the measured implant force, or its change from a reference activity.",
  "simulate": [
    "Scale the model to the patient (\"patients\") for per-patient refs, or to the cohort mean for group refs.",
    "Set the activity and posture; add hand loads, supports or limb positions as stated.",
    "VBR tasks: output the resultant force across the implant level (L1; L3 for WP5).",
    "Fixator tasks: for each of the 10 patients (FX1-FX10), output the flexion moment across that patient's bridged segments as % of relaxed standing; answer the mean of the 10.",
    "Increase and change tasks: simulate the reference activity with the same model and report the difference (N) or change (%)."
  ],
  "inputs": [
    {
      "key": "activity",
      "label": "Activity"
    },
    {
      "key": "trunk_inclination_deg",
      "label": "Trunk inclination",
      "unit": "deg"
    },
    {
      "key": "hand_load_kg",
      "label": "Hand load",
      "unit": "kg"
    },
    {
      "key": "reference",
      "label": "Reference activity"
    }
  ],
  "outputs": [
    {
      "key": "vbr_force",
      "label": "Implant (VBR) force",
      "unit": "N",
      "definition": "Resultant force on the telemetered vertebral body replacement (VBR) at L1 (N)"
    },
    {
      "key": "vbr_force_increase",
      "label": "VBR force increase over reference",
      "unit": "N",
      "definition": "VBR force in the task minus VBR force in the reference activity (N)"
    },
    {
      "key": "vbr_force_change",
      "label": "VBR force change vs reference",
      "unit": "%",
      "definition": "(VBR force in task - in reference) / reference x 100 (%)"
    },
    {
      "key": "fixator_moment_rel",
      "label": "Fixator flexion moment, % of standing",
      "unit": "% of standing",
      "definition": "Flexion moment on the telemetered internal fixator, as % of relaxed standing"
    }
  ],
