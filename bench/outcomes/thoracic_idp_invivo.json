{
  "id": "thoracic_idp_invivo",
  "title": "Thoracic disc pressure in vivo",
  "domain": "msk",
  "region": "thoracic",
  "levels": [
    "T6-T7",
    "T7-T8",
    "T9-T10",
    "T10-T11"
  ],
  "summary": "Simulate each standing posture or hand-load task for the Polga subject and report mid and lower thoracic intradiscal pressure (MPa).",
  "simulate": [
    "Scale the model to the Polga subject (male, 28 y, 178 cm, 73 kg).",
    "Set the posture: trunk flexion, extension, lateral bending or axial twist as stated.",
    "Add the hand load: 10 kg per hand, arms at the sides or elbows at 90°.",
    "Output compression F and flexion θ at T6-T7 and T7-T8 (average = mid) and T9-T10 and T10-T11 (average = lower).",
    "IDP = Ghezelbash 2016 Eq. 6 with P = F/A (A = 663 mm2 mid, 897 mm2 lower; θ = segment flexion), or IDP = F/(0.66A)."
  ],
  "inputs": [
    {
      "key": "posture",
      "label": "Posture"
    },
    {
      "key": "flexion_deg",
      "label": "Trunk flexion (+) / extension (-)",
      "unit": "deg"
    },
    {
      "key": "axial_rotation_deg",
      "label": "Axial rotation",
      "unit": "deg"
    },
    {
      "key": "hand_load_kg",
      "label": "Total hand load",
      "unit": "kg"
    },
    {
      "key": "arm_position",
      "label": "Arm position"
    }
  ],
  "outputs": [
    {
      "key": "idp",
      "label": "IDP",
      "unit": "MPa",
      "definition": "IDP = absolute nucleus pressure (MPa); mid = mean of T6-T7 and T7-T8, lower = mean of T9-T10 and T10-T11"
    }
  ],
  "subjects": {
    "polga2004": {
      "sex": "male (modelled; cohort 4M/2F)",
      "age": 28,
      "height_cm": 178,
      "weight_kg": 73,
      "disc_area_mm2": {
        "mid": 663,
        "lower": 897
      },
      "note": "Polga Methods: 4M/2F, 28 y (19-47), 178 cm, 73 kg; areas = Kishimoto 2016 CT, 4M:2F weighted"
    }
  },
  "studies": [
    {
      "key": "polga2004",
      "short": "Polga 2004",
      "year": 2004,
      "n": 6,
      "sample": "6 healthy volunteers (4M/2F), mid and lower thoracic discs",
      "doi": "10.1097/01.BRS.0000127179.13271.78",
      "secondary": false
    }
  ],
  "shared": [],
  "views": [
    {
      "id": "postures",
      "title": "Standing postures",
      "task_ids": [
        "stand_mid",
        "stand_lower",
        "flex30_mid",
