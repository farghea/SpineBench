{
  "id": "ex_lumbar_rom",
  "example": true,
  "title": "Lumbar range of motion (example)",
  "domain": "fe",
  "region": "lumbar",
  "levels": [
    "L4-L5"
  ],
  "summary": "Apply pure moments to the intact L4-L5 segment and report its rotation in the loading plane.",
  "simulate": [
    "Use an intact ligamentous L4-L5 segment (no muscles).",
    "Fix the lower vertebra; apply a pure moment to the upper one.",
    "No preload.",
    "Report main rotation (deg) at each moment, one direction."
